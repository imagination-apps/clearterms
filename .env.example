# ===== ClearTerms 環境変数(Vercel の Settings → Environment Variables に登録) =====

# ---- 必須 ----
SUPABASE_URL=https://sutqpzlkbdpkovoclfyz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=price_1UKXWI0k5W3Rtn5JK5sYfaMe
# Stripe Webhook 登録後に設定(購入処理に必要)
STRIPE_WEBHOOK_SECRET=

# ---- 任意(空なら自動) ----
# 送信元。空なら Resend の認証済みドメインから noreply@… を自動設定
MAIL_FROM=
# 空なら SUPABASE_SERVICE_ROLE_KEY から自動生成
SESSION_SECRET=
IP_HASH_SALT=
# 空なら Vercel Cron からの呼び出しを User-Agent で判定
CRON_SECRET=
# 空なら Vercel の本番URLを自動使用
SITE_URL=
