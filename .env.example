# ===== ClearTerms 環境変数(Vercel の Settings → Environment Variables に登録) =====

# Supabase(CSV Bridge と同じプロジェクトに相乗り)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic(Claude API)
ANTHROPIC_API_KEY=

# Resend(CSV Bridge と同じキー・送信元ドメインでOK)
RESEND_API_KEY=
MAIL_FROM=ClearTerms <noreply@your-domain.com>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ランダムな長い文字列(下記コマンド等で生成)
#   openssl rand -hex 32
SESSION_SECRET=
IP_HASH_SALT=
CRON_SECRET=

# 公開URL(メール内リンク・Stripeの戻り先に使用)
SITE_URL=https://clearterms.vercel.app
